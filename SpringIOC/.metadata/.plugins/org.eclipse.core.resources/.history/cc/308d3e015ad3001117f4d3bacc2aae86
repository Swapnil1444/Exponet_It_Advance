package com.model;

public class Employee {
	
	private int Empid;
	private String Empname;
	
	private Address parmantAddress;
	private Address currentAddress;
	private Department dept;
	public int getId() {
		return id;
	}
	public void setId(int id) {
		this.id = id;
	}
	public String getName() {
		return name;
	}
	public void setName(String name) {
		this.name = name;
	}
	public Department getDept() {
		return dept;
	}
	public void setDept(Department dept) {
		dept = dept;
	}
	
	
	public Address getParmantAddress() {
		return parmantAddress;
	}
	public void setParmantAddress(Address parmantAddress) {
		this.parmantAddress = parmantAddress;
	}
	public Address getCurrentAddress() {
		return currentAddress;
	}
	public void setCurrentAddress(Address ucurrentAddress) {
		this.currentAddress = currentAddress;
	}
	@Override
	public String toString() {
		return "Employee [id=" + id + ", name=" + name + ", Dept=" + dept + ", parmantAddress=" + parmantAddress
				+ ", currentAddress=" + currentAddress + "]";
	}
	
	

}
